*.key
*.pem
local.properties

# The downloaded SQuAD file. The committed sample is data/sample.json.
data/raw/

# JVM crash dumps
hs_err_pid*
replay_pid*
*.hprof
*.log

# Run directory lock, written while a run is in progress.
**/.lock
